      "water": "#D5DAD2",
      "green": "#E4E5CB",
      "note": "Not in the official palette; pending designer approval. Building/road tints are derived from Cream/Light Beige."
    },
    "jobdrop:tileSchema": "OpenMapTiles (OpenFreeMap planet). Layer names depend on the tile provider."
