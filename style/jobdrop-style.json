    "jobdrop:palette": {
      "cream": "#F4EBDA",
      "beige": "#F3C793",
      "sand": "#E0AC72",
      "caramel": "#B5804F",
      "warm": "#86502B",
      "deep": "#723E21",
      "dark": "#592D16"
    },
